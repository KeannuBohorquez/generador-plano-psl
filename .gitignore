venv/
env/
.env
build_venv/

# ── PyInstaller ───────────────────────────────────────────────
*.spec
dist/
build_tmp/

# ── Datos sensibles (NUNCA subir al repo) ────────────────────
*.pdf
*.xls
*.xlsx
*.xlsm
finales/
enero/finales/

# ── IDEs ──────────────────────────────────────────────────────
.idea/
.vscode/
*.suo
*.user
*.sln.docstates
Thumbs.db
.DS_Store

# ── Logs y temporales ─────────────────────────────────────────
*.log
*.tmp
*.bak
